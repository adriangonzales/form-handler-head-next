# The Backend's API base, called only from this server. Use The Backend's public origin: it builds
# signed export download links from the host it sees on these requests.
BACKEND_API_URL=http://127.0.0.1:8001/api

# The Backend's OpenAPI spec, for `pnpm api:types` and the contract tests. Optional: derived from
# BACKEND_API_URL (`…/api` → `…/docs/api.json`) when unset.
# BACKEND_SPEC_URL=http://127.0.0.1:8001/docs/api.json

# How long after login a token can still be refreshed, in seconds. Keep equal to The Backend's
# refresh window (7 days for the reference Backend). Also the session cookie's lifetime.
BACKEND_REFRESH_WINDOW_SECONDS=604800

# Refresh the token when it expires within this many seconds.
AUTH_REFRESH_AHEAD_SECONDS=120

# Seals the session cookie and encrypts refresh results in Redis. At least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Shares token refreshes between server instances. Required in production; without it in
# development, refreshes are coordinated in memory. `pnpm services:up` starts a development Redis
# on this URL (compose.yaml).
# REDIS_URL=redis://127.0.0.1:6379

# Host port for the development Redis in compose.yaml, if 6379 is taken. Update REDIS_URL to match.
# REDIS_PORT=6379

# Shown in embed snippets and used by the browser-side test-submit tool. Inlined at build time.
NEXT_PUBLIC_BACKEND_PUBLIC_URL=http://127.0.0.1:8001/api

# Password rules shown on the Account and reset pages. Match The Backend's policy; for the reference
# Backend in production: "Use at least 12 characters, with upper- and lower-case letters, numbers and
# symbols. Passwords found in known data breaches aren't allowed." Inlined at build time.
NEXT_PUBLIC_PASSWORD_REQUIREMENTS="Use at least 8 characters."

# Tests. A command that creates a throwaway user, since the contract has no sign-up endpoint.
# {name}, {email} and {password} are replaced; the tests delete these users through the API
# afterwards. Playwright and the contract suite's sign-in checks need it.
# For the reference Backend:
# E2E_CREATE_USER_CMD="cd ../form-handler-headless-laravel && php artisan user:create --name={name} --email={email} --password={password} --no-interaction"
# For the mock backend (`pnpm mock:backend`):
# E2E_CREATE_USER_CMD="curl -sf -X POST http://127.0.0.1:8010/__mock/users -H 'Content-Type: application/json' -d '{\"name\":\"{name}\",\"email\":\"{email}\",\"password\":\"{password}\"}'"
E2E_CREATE_USER_CMD=

# Port for the dev server Playwright starts (it never reuses yours). Default 3100.
# E2E_PORT=3100
