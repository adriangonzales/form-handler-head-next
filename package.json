    "test:watch": "vitest --project unit --project component",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test",
    "api:types": "node --env-file-if-exists=.env scripts/generate-api-types.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
