{
  "name": "form-handler-head-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "mock:backend": "tsx scripts/mock-backend.ts",
    "build": "next build",
    "start": "next start",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
